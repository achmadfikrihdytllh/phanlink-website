+        @if (fieldErrors()['name']) { <em>{{ fieldErrors()['name'] }}</em> }
+      </label>
+
+      <label>
+        <span class="pm-label">Username</span>
+        <input class="field" maxlength="50" [ngModel]="username()" (ngModelChange)="username.set($event); edited()" />
+        @if (fieldErrors()['username']) { <em>{{ fieldErrors()['username'] }}</em> }
+      </label>
+
+      <label>
+        <span class="pm-label">Bio</span>
+        <textarea class="field" rows="3" maxlength="500" [ngModel]="bio()" (ngModelChange)="bio.set($event); edited()"></textarea>
+        @if (fieldErrors()['bio']) { <em>{{ fieldErrors()['bio'] }}</em> }
+      </label>
+
+      <label>
+        <span class="pm-label">Phone number</span>
+        <input class="field" maxlength="20" inputmode="tel" [ngModel]="phone()" (ngModelChange)="phone.set($event); edited()" />
