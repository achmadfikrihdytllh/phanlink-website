+        <p class="err">{{ error() }}</p>
+      }
+    </section>
+
+    <nav class="links">
+      <a routerLink="/settings"><pm-icon name="settings" [size]="12" /> Preferences</a>
+      <button type="button" (click)="signOut()"><pm-icon name="logout" [size]="12" /> Sign out</button>
+    </nav>
