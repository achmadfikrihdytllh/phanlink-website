+/**
+ * Local sample data for the pages that have no backend endpoint yet
+ * (Groups, Saved, Contacts, Search). Swap each export for a service call
+ * when the matching API exists; the page templates only depend on these shapes.
+ */
+
+export interface Confidant {
+  id: number;
+  name: string;
+  codename: string;
+  handle: string;
+  school: string;
+  status: 'online' | 'offline';
+  note: string;
+  lastSeen: string;
+}
+
+export interface SharedFile {
+  name: string;
+  meta: string;
+  kind: 'file' | 'image' | 'calendar' | 'map';
+}
+
+export interface Group {
+  id: number;
+  name: string;
+  members: number;
+  online: number;
+  blurb: string;
+}
+
+export interface SavedMessage {
+  id: number;
+  author: string;
+  group: string;
+  time: string;
+  body: string;
+  collection: string;
+  day: 'today' | 'yesterday';
