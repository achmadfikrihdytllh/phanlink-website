+<pm-page-frame>
+  <div slot="list">
+    <header class="pm-list-head">
+      <h1 class="pm-title">Saved</h1>
+      <button class="pm-icon-btn" type="button" aria-label="New collection">
+        <pm-icon name="plus" [size]="12" />
+      </button>
+    </header>
+    <label class="pm-search">
+      <pm-icon name="search" [size]="11" />
+      <input
+        type="text"
+        placeholder="Search your saved intel"
+        [value]="query()"
+        (input)="query.set($any($event.target).value)"
+      />
+    </label>
+    <div class="pm-eyebrow label">Your collections</div>
+    <ul class="cols">
+      @for (c of collections; track c.name) {
+        <li>
+          <button
+            type="button"
+            class="pm-list-item"
+            [class.active]="collection() === c.name"
+            (click)="collection.set(c.name)"
+          >
+            <span class="pm-list-item__text"><strong>{{ c.name }}</strong></span>
+            <span class="count">{{ c.count }}</span>
+          </button>
+        </li>
+      }
+    </ul>
+    <p class="hint">Keep the good stuff close. Save a message from any conversation to find it here.</p>
+  </div>
+
+  <div slot="main" class="page">
+    <header class="pm-hero">
+      <div>
+        <div class="pm-eyebrow">Personal archive / Only you can see this</div>
+        <h2 class="pm-title">Saved messages</h2>
+      </div>
+      <button class="pm-btn" type="button"><span>New collection</span></button>
+    </header>
+
+    <div class="tabrow">
+      @for (t of tabs; track t.id) {
+        <button type="button" [class.on]="tab() === t.id" (click)="tab.set(t.id)">{{ t.label }}</button>
+      }
+    </div>
+
+    <div class="stream pm-scroll">
+      @for (group of days(); track group.label) {
+        @if (group.items.length) {
+          <div class="day">{{ group.label }} / {{ group.items.length }} saves</div>
+          @for (s of group.items; track s.id) {
+            <article class="card" [class.card--on]="focus()?.id === s.id" (click)="pick(s)">
+              <header>
+                <span class="pm-avatar pm-avatar--light">{{ s.author.charAt(0) }}</span>
+                <strong>{{ s.author }}</strong>
+                <small>{{ s.group }} · {{ s.time }}</small>
+                <pm-icon name="saved" [size]="12" />
+              </header>
+              <p>{{ s.body }}</p>
+              @if (s.attachment; as a) {
+                <div class="attach"><pm-icon name="file" [size]="12" />{{ a.name }}</div>
+              }
+              <footer>
+                <span class="tag">{{ s.collection }}</span>
+                <a routerLink="/messages" class="jump">Jump to message</a>
+              </footer>
+            </article>
+          }
+        }
+      }
+      @if (!visible().length) {
+        <p class="none">Nothing saved here yet.</p>
+      }
+    </div>
+  </div>
+
+  <div slot="aside">
+    @if (focus(); as f) {
+      <section class="pm-section">
+        <div class="pm-eyebrow">Saved attachment</div>
+        <h2 class="pm-title">{{ f.attachment ? 'The game plan' : 'Saved message' }}</h2>
+      </section>
+
+      <section class="pm-section">
+        <div class="preview">
+          <pm-icon name="star" [size]="16" />
+          <h3 class="pm-title">{{ f.attachment ? 'Tomorrow’s game plan.' : f.collection }}</h3>
+          <p>{{ f.body }}</p>
+        </div>
+        <div class="meta">
+          <span class="pm-label">Original message</span>
+          <small>{{ f.author }} · {{ f.time }}</small>
+          <span class="pm-label">Collection</span>
+          <small>{{ f.collection }}</small>
+        </div>
+        @if (f.attachment) {
+          <button type="button" class="pm-btn side"><span>Download file</span></button>
+        }
+        <a routerLink="/messages" class="pm-btn pm-btn--dark side"><span>Open in conversation</span></a>
+      </section>
+    }
+  </div>
+</pm-page-frame>
